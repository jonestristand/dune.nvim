    "theme",
    "color-theme",
    "dark",
    "dune",
    "atreides",
    "harkonnen",
    "corrino",
    "fremen",
    "tleilaxu"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
