      },
      {
        "label": "Dune Harkonnen",
        "uiTheme": "vs-dark",
        "path": "./themes/dune-harkonnen-color-theme.json"
      },
      {
        "label": "Dune Corrino",
        "uiTheme": "vs-dark",
        "path": "./themes/dune-corrino-color-theme.json"
      },
      {
        "label": "Dune Fremen",
        "uiTheme": "vs-dark",
        "path": "./themes/dune-fremen-color-theme.json"
      },
      {
        "label": "Dune Tleilaxu",
        "uiTheme": "vs-dark",
        "path": "./themes/dune-tleilaxu-color-theme.json"
      }
    ]
