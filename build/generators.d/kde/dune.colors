[ColorEffects:Disabled]
Color=${surface}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=${bg_dim}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=${surface}
BackgroundNormal=${overlay}
DecorationFocus=${accent}
DecorationHover=${accent_hover}
ForegroundActive=${special}
ForegroundInactive=${muted}
ForegroundLink=${fn}
ForegroundNegative=${err}
ForegroundNeutral=${num}
ForegroundNormal=${fg}
ForegroundPositive=${add}
ForegroundVisited=${ty}

[Colors:Complementary]
BackgroundAlternate=${surface}
BackgroundNormal=${bg_dim}
DecorationFocus=${accent}
DecorationHover=${accent_hover}
ForegroundActive=${special}
ForegroundInactive=${muted}
ForegroundLink=${fn}
ForegroundNegative=${err}
ForegroundNeutral=${num}
ForegroundNormal=${fg}
ForegroundPositive=${add}
ForegroundVisited=${ty}

[Colors:Header]
BackgroundAlternate=${surface}
BackgroundNormal=${bg_dim}
DecorationFocus=${accent}
DecorationHover=${accent_hover}
ForegroundActive=${special}
ForegroundInactive=${muted}
ForegroundLink=${fn}
ForegroundNegative=${err}
ForegroundNeutral=${num}
ForegroundNormal=${fg}
ForegroundPositive=${add}
ForegroundVisited=${ty}

[Colors:Header][Inactive]
BackgroundAlternate=${surface}
BackgroundNormal=${bg_dim}
DecorationFocus=${overlay}
DecorationHover=${overlay}
ForegroundActive=${muted}
ForegroundInactive=${muted}
ForegroundLink=${muted}
ForegroundNegative=${err}
ForegroundNeutral=${muted}
ForegroundNormal=${muted}
ForegroundPositive=${muted}
ForegroundVisited=${muted}

[Colors:Selection]
BackgroundAlternate=${selection}
BackgroundNormal=${selection}
DecorationFocus=${accent}
DecorationHover=${accent_hover}
ForegroundActive=${special}
ForegroundInactive=${fg_dim}
ForegroundLink=${fn}
ForegroundNegative=${err}
ForegroundNeutral=${num}
ForegroundNormal=${fg}
ForegroundPositive=${add}
ForegroundVisited=${ty}

[Colors:Tooltip]
BackgroundAlternate=${overlay}
BackgroundNormal=${surface}
DecorationFocus=${accent}
DecorationHover=${accent_hover}
ForegroundActive=${special}
ForegroundInactive=${muted}
ForegroundLink=${fn}
ForegroundNegative=${err}
ForegroundNeutral=${num}
ForegroundNormal=${fg}
ForegroundPositive=${add}
ForegroundVisited=${ty}

[Colors:View]
BackgroundAlternate=${bg_dim}
BackgroundNormal=${bg}
DecorationFocus=${accent}
DecorationHover=${accent_hover}
ForegroundActive=${special}
ForegroundInactive=${muted}
ForegroundLink=${fn}
ForegroundNegative=${err}
ForegroundNeutral=${num}
ForegroundNormal=${fg}
ForegroundPositive=${add}
ForegroundVisited=${ty}

[Colors:Window]
BackgroundAlternate=${overlay}
BackgroundNormal=${surface}
DecorationFocus=${accent}
DecorationHover=${accent_hover}
ForegroundActive=${special}
ForegroundInactive=${muted}
ForegroundLink=${fn}
ForegroundNegative=${err}
ForegroundNeutral=${num}
ForegroundNormal=${fg}
ForegroundPositive=${add}
ForegroundVisited=${ty}

[General]
ColorScheme=${scheme}
Name=${display}
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground=${bg_dim}
activeBlend=${fg}
activeForeground=${fg}
inactiveBackground=${bg_dim}
inactiveBlend=${muted}
inactiveForeground=${muted}
